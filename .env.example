NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MEMBERSHIP_MONTHLY_PRICE=15000
# Bunny Stream: clave de "Embed view token authentication" (solo servidor). Vacía = embeds sin firmar.
BUNNY_STREAM_TOKEN_KEY=
# Solo entornos de prueba (Preview / desarrollo): ciclo de cobro en días (1-30). Se ignora en producción.
# MEMBERSHIP_TEST_BILLING_FREQUENCY_DAYS=1
# CRON_SECRET (más abajo) también protege la conciliación diaria de membresías (/api/mercadopago/reconcile).

# Mi Negocio / Mercado Pago Marketplace (separado de membresías)
MERCADO_PAGO_MARKETPLACE_CLIENT_ID=
MERCADO_PAGO_MARKETPLACE_CLIENT_SECRET=
MERCADO_PAGO_MARKETPLACE_REDIRECT_URI=
MERCADO_PAGO_MARKETPLACE_WEBHOOK_SECRET=
BUSINESS_PAYMENT_TOKEN_ENCRYPTION_KEY=
BUSINESS_CHECKOUT_FINGERPRINT_SECRET=
BUSINESS_MARKETPLACE_FEE_PERCENT=0
BUSINESS_MERCADO_PAGO_ALLOW_LIVE=false
CRON_SECRET=

SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Modelo de Stampy (Responses API). Vacío = gpt-5.6-terra.
# Ojo: Stampa Maker (jarros) también lo usa como fallback de MUG_AI_MODEL.
OPENAI_MODEL=
# Razonamiento de Stampy: none|minimal|low|medium|high, u "off" para modelos sin razonamiento. Vacío = low.
STAMPY_REASONING_EFFORT=
# Opcionales: low|medium|high (vacío = default del modelo) y tope de tokens de salida (vacío = 4000).
STAMPY_TEXT_VERBOSITY=
STAMPY_MAX_OUTPUT_TOKENS=

# Explorar Modelos (solo servidor; nunca usar NEXT_PUBLIC_)
# Cults3D: nickname + API key creada desde la cuenta de Cults.
CULTS_USERNAME=
CULTS_API_KEY=
# MyMiniFactory API v2.
MYMINIFACTORY_API_KEY=
# Thingiverse Developer Program. Mantener vacío hasta aprobar términos/uso de producción.
THINGIVERSE_ACCESS_TOKEN=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
STAMPY_RETRIEVAL_ENABLED=true
STAMPY_RETRIEVAL_MAX_CHUNKS=8
STAMPY_RETRIEVAL_MIN_SIMILARITY=0.72

# Códigos de descuento en el checkout de la membresía (ver docs/DEPLOY_DISCOUNT_CODES.md).
# Apagado por defecto: solo el valor exacto "true" lo activa. Aplicar antes la migration 20261029120000.
DISCOUNT_CODES_ENABLED=false

# Agenda de precio de promociones por períodos (Pioneros). Ver docs/DEPLOY_PRICE_SCHEDULES.md.
# Solo el valor exacto "true" activa cada interruptor.
PRICE_SCHEDULES_ENABLED=false
# NO activar hasta validar el cambio de importe (PUT /preapproval) contra Mercado Pago (docs/MP_PRICE_CHANGE_SPIKE.md).
PRICE_STEP_UP_ENABLED=false

# Correo transaccional de la aplicación con Resend (solo servidor; nunca NEXT_PUBLIC_). Ver docs/RESEND_EMAIL_SETUP.md.
# Los correos de Supabase Auth (confirmación, recuperación) NO usan estas variables: van por el SMTP del panel de Supabase.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej.: Universo Stampa <avisos@tu-dominio>
PRICE_NOTICE_FROM=
# Destinatario interno de las alertas de promociones (no es un cliente).
PRICE_ALERT_EMAIL=
